# Copy this file to `.env.local` and fill in the values for your band's
# Sanity project. Find the project ID at https://www.sanity.io/manage.

# Public Sanity config — safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-17

# Server-only token. NEVER prefix with NEXT_PUBLIC_.
# Used for draft/preview reads and — when BOOKING_DELIVERY=sanity — for writing
# form submissions. Create one at https://www.sanity.io/manage -> API -> Tokens.
# A Viewer token suffices for reads; form delivery to Sanity needs Editor scope.
SANITY_API_TOKEN=

# Form delivery — how booking enquiries and mailing-list signups are handled.
# "sanity" writes a bookingRequest / subscriber document (needs an Editor-scoped
# SANITY_API_TOKEN above). "email" sends the submission via Resend.
BOOKING_DELIVERY=sanity

# Required only when BOOKING_DELIVERY=email:
# RESEND_API_KEY  — from https://resend.com -> API Keys
# RESEND_FROM     — a verified sender address, e.g. "Band <hello@band.com>"
# BOOKING_EMAIL_TO — where submissions are sent, e.g. "bookings@band.com"
RESEND_API_KEY=
RESEND_FROM=
BOOKING_EMAIL_TO=
